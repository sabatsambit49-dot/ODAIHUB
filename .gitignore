# Dependencies - never commit these
node_modules/
package-lock.json

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env
*.env

# Build outputs
dist/
build/
*.egg-info/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Uploads (user-uploaded media files)
backend/uploads/*
uploads/*
!uploads/.gitkeep
!backend/uploads/.gitkeep

# Static generated images
backend/static/images/*
!backend/static/images/.gitkeep

# NOTE: database/edutrack.db IS included in this repo intentionally
# It is pre-seeded with sample data for quick setup
